CMC_API_KEY=*** ## example: f83625da-4047-4556-8567-afeea31e9754
NEXT_PUBLIC_SITE_URL=localhost:3000
NEXT_PUBLIC_BLOCKFROST_KEY_MAINNET=""
NEXT_PUBLIC_BLOCKFROST_KEY_PREPROD=""
NEXT_PUBLIC_VERCEL_ENV=development
NODE_AUTH_TOKEN=YOUR_GITHUB_NODE_AUTH_TOKEN_HERE
NEXT_PUBLIC_REOWN_ID=29d5437dba48a841d85dfb73e6cc38ad

## Testnet faucet proxy (server-side only — never expose to the browser)
## Base URL of the Midgard node exposing POST /faucet/claims
MIDGARD_FAUCET_NODE_URL=https://sundial-node.testnet.sundialprotocol.com
## Bearer key matching the node's FAUCET_API_KEY
MIDGARD_FAUCET_API_KEY=
## Salt mixed into the SHA-256 IP hash sent to the node
FAUCET_IP_HASH_SALT=