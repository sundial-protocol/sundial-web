CMC_API_KEY=*** ## example: f83625da-4047-4556-8567-afeea31e9754
NEXT_PUBLIC_SITE_URL=localhost:3000
NEXT_PUBLIC_BLOCKFROST_KEY_MAINNET=""
NEXT_PUBLIC_BLOCKFROST_KEY_PREPROD=""
NEXT_PUBLIC_VERCEL_ENV=development
NODE_AUTH_TOKEN=YOUR_GITHUB_NODE_AUTH_TOKEN_HERE
NEXT_PUBLIC_REOWN_ID=29d5437dba48a841d85dfb73e6cc38ad

## Testnet faucet proxy (server-side only - never expose to the browser)
## Bearer key matching the node's FAUCET_API_KEY
MIDGARD_FAUCET_API_KEY=
## Salt mixed into the SHA-256 IP hash sent to the node
FAUCET_IP_HASH_SALT=
## Base URL of the Sundial node exposing GET /utxos & faucet. Required — with it unset
## the balance route returns 503 NOT_CONFIGURED rather than inventing a number.
SUNDIAL_L2_NODE_URL=https://rpc.testnet.sundialprotocol.com

## Transfer service, covering on-chain sends, L2 sends and the charms beam
## peg-in (server-side only).
## LEAVE UNSET while the service does not exist: app/api/transfer/* then answers
## from the in-memory mock orchestrator and the UI labels itself as simulated.
## Setting it makes every transfer route proxy to the real service instead —
## that is the entire mock-to-real switch. See app/dashboard/transfer/README.md.
TRANSFER_API_URL=